msgstr "%1$s %2$s:1"

# machine translation
#: includes/features/class-seoprostack-kadence-colour-check.php:315
msgid "dark"
msgstr "sombre"

# machine translation
#: includes/features/class-seoprostack-kadence-colour-check.php:315
msgid "light"
msgstr "lumière"

# machine translation
#. translators: 1: text setting and colour, 2: background setting and colour, 3: contrast in each mode, 4: contrast needed.
#: includes/features/class-seoprostack-kadence-colour-check.php:321
#, php-format
