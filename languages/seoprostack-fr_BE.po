msgid_plural "%d pictures are waiting to be converted. Run wp seoprostack convert-images first."
msgstr[0] "L'image %d est en attente de conversion. Veuillez d'abord exécuter la commande wp seoprostack convert-images."
msgstr[1] "Les images %d sont en attente de conversion. Veuillez d'abord exécuter la commande wp seoprostack convert-images."

# machine translation
#: includes/features/class-seoprostack-nextgen-images.php:1793
msgid "The CompressX folder is not a regular folder. No files were removed."
msgstr "Le dossier CompressX n'est pas un dossier ordinaire. Aucun fichier n'a été supprimé."

# machine translation
#: includes/features/class-seoprostack-nextgen-images.php:1799
