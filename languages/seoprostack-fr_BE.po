msgstr "Dernière lecture il y a %s jours."

# machine translation
#. translators: 1: new tickets, 2: replies, 3: emails passed over, 4: emails Fluent Support refused
#: includes/features/class-seoprostack-helpdesk-imap.php:294
#, php-format
msgid "New tickets: %1$d. Replies: %2$d. Passed over: %3$d. Refused: %4$d."
msgstr "Nouveaux billets : %1$d. Réponses : %2$d. Transmis : %3$d. Refusé : %4$d."

# machine translation
#: includes/features/class-seoprostack-helpdesk-imap.php:337
msgid "Fluent Support email by IMAP is off (Plugins tab)."
msgstr "La messagerie Fluent Support par IMAP est désactivée (onglet Plugins)."

# machine translation
