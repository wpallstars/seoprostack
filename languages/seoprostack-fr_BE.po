msgstr "CompressX est toujours actif. Veuillez le désactiver d'abord."

# machine translation
#: includes/features/class-seoprostack-nextgen-images.php:1662
msgid "WebP and AVIF images is off or makes no format here."
msgstr "Les images WebP et AVIF ne sont pas prises en charge ou ne sont pas formatées ici."

# machine translation
#: includes/features/class-seoprostack-nextgen-images.php:1665
