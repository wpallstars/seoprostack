msgstr "Ausgeschlossene Inhaltstypen"

#: includes/features/class-seoprostack-auto-upload.php:200
msgid "Images served from another address"
msgstr "Unter einer anderen Adresse bereitgestellte Bilder"

#: includes/features/class-seoprostack-auto-upload.php:455
msgid "The file is not an allowed image type."
msgstr "Die Datei hat keinen zulässigen Bildtyp."

#: includes/features/class-seoprostack-auto-upload.php:492
