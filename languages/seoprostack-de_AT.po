msgstr "Silhouette"

#: includes/features/class-seoprostack-avatar-privacy.php:351
msgid "Pattern (different for each person)"
msgstr "Muster (für jeden Benutzer unterschiedlich)"

#: includes/features/class-seoprostack-avatar-privacy.php:352
msgid "Blank"
msgstr "Leer"

#: includes/features/class-seoprostack-avatar-privacy.php:649
msgid "The uploads folder is not writable."
msgstr "Das Upload-Verzeichnis ist nicht beschreibbar."

#: includes/features/class-seoprostack-avatar-privacy.php:663 includes/features/class-seoprostack-avatar-privacy.php:1088
msgid "The picture could not be read."
msgstr "Das Bild konnte nicht gelesen werden."

#: includes/features/class-seoprostack-avatar-privacy.php:1007
