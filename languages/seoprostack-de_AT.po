msgstr "Maximale Höhe"

#: includes/features/class-seoprostack-auto-upload.php:83
msgid "Excluded domains"
msgstr "Ausgeschlossene Domains"

#: includes/features/class-seoprostack-auto-upload.php:84
msgid "One domain per line. Images from these domains (and their subdomains) stay external."
msgstr "Eine Domain pro Zeile. Bilder von diesen Domains und ihren Subdomains bleiben extern."

