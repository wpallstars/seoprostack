#: includes/features/class-seoprostack-brand-icons.php:67 includes/features/class-seoprostack-brand-icons.php:658 blocks/brand-icon/index.js:104
msgid "Brand icons"
msgstr "Markensymbole"

#: includes/features/class-seoprostack-brand-icons.php:68
msgid "A Brand icon block with about 3,800 brand logos (Simple Icons and Font Awesome), in the brand’s colour or your text colour. Icons are part of the page, so nothing extra loads. The [simple_icon] shortcode and #name# menu titles keep working."
msgstr "Ein Markensymbol-Block mit etwa 3.800 Markenlogos (Simple Icons und Font Awesome), in Marken- oder Textfarbe. Die Symbole sind Teil der Seite, es wird nichts zusätzlich geladen. Der Shortcode [simple_icon] und Menütitel mit #name# funktionieren weiterhin."

#: includes/features/class-seoprostack-bulk-select-all.php:42
msgid "Select all across pages"
msgstr "Alle seitenübergreifend auswählen"

#: includes/features/class-seoprostack-bulk-select-all.php:43
msgid "In post lists, select every item that matches the current filters, not just the page you can see, and apply a bulk action to all of them."
msgstr "Wählt in Beitragslisten alle Einträge aus, die den aktuellen Filtern entsprechen, nicht nur die auf der sichtbaren Seite. Mehrfachaktionen werden auf alle ausgewählten Einträge angewendet."

#. translators: %d: number of items on this page
#: includes/features/class-seoprostack-bulk-select-all.php:129
#, php-format
msgid "All %d items on this page are selected."
msgstr "Alle %d Einträge auf dieser Seite sind ausgewählt."

