#: includes/features/class-seoprostack-hosting-needs.php:1770
#, php-format
msgid "its file list is nearly full (%1$s of %2$s)"
msgstr "Die Dateiliste ist fast voll (%1$s von %2$s)"

# machine translation
#: includes/features/class-seoprostack-hosting-needs.php:1778
msgid "OPcache interned strings"
msgstr "OPcache-internierte Zeichenketten"

# machine translation
#: includes/features/class-seoprostack-hosting-needs.php:1784
msgid "its space for shared strings is nearly full"
msgstr "Der Speicherplatz für gemeinsam genutzte Zeichenketten ist nahezu voll."

# machine translation
#: includes/features/class-seoprostack-hosting-needs.php:1794
msgid "OPcache hit rate"
msgstr "OPcache-Trefferrate"

