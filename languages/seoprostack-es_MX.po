msgstr "Nombre del servidor, con :993 (SSL, el predeterminado) o :143 (STARTTLS), como por ejemplo mail.example.com:993. El certificado siempre se comprueba."

# machine translation
#: includes/features/class-seoprostack-helpdesk-imap.php:118
msgid "User name"
msgstr "Nombre de usuario"

# machine translation
#: includes/features/class-seoprostack-helpdesk-imap.php:119
msgid "Usually the mailbox’s email address."
msgstr "Normalmente, la dirección de correo electrónico del buzón."

# machine translation
#: includes/features/class-seoprostack-helpdesk-imap.php:126
