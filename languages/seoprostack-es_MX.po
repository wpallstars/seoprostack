# machine translation
#: includes/features/class-seoprostack-kadence-colour-check.php:528
msgid "Category pill text (white, set by Kadence)"
msgstr "Texto de la categoría de la píldora (blanco, establecido por Kadence)"

# machine translation
#. translators: %s: number of colours.
#: includes/features/class-seoprostack-kadence-colour-check.php:971
#, php-format
msgid "%s Kadence colour now follows the palette. Restore in Site Health puts the old colour back."
msgid_plural "%s Kadence colours now follow the palette. Restore in Site Health puts the old colours back."
