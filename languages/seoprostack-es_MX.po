#, php-format
msgid "Waiting for your choice. Held since %1$s, last %2$s."
msgstr "Esperando tu elección. En espera desde %1$s, última %2$s."

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:960
msgid "Allow once now"
msgstr "Permitir una vez ahora"

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:961
msgid "Once a day"
msgstr "Una vez al día"

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:962
msgid "Never"
msgstr "Nunca"

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:971
msgid "These plugins want to check their licence with their maker’s server. Until you choose, nothing is sent and the plugin is told the server could not be reached."
msgstr "Estos complementos necesitan verificar su licencia con el servidor de su creador. Hasta que usted lo indique, no se envía nada y se le informa al complemento que no se pudo acceder al servidor."

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:988
msgid "Forget my choice"
msgstr "Olvida mi elección"

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:994
msgid "Allow once now lets the plugin’s next check through when it next asks (within the hour), then asks you again. Once a day lets the first check each day through and gives the plugin that answer for the rest of the day, so pages do not wait. Update checks are never held. Choose again, or forget your choices, from the Licence checks link on the Plugins screen."
msgstr "La opción \"Permitir una vez\" permite que el plugin realice la siguiente comprobación cuando lo solicite (dentro de la hora), y luego le preguntará de nuevo. La opción \"Una vez al día\" permite que se realice la primera comprobación diaria y proporciona al plugin esa respuesta para el resto del día, evitando así que las páginas esperen. Las comprobaciones de actualización nunca se detienen. Puede volver a seleccionar o borrar sus opciones desde el enlace \"Comprobaciones de licencia\" en la pantalla de Plugins."

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:1000
msgid "Ask me again:"
msgstr "Pregúntame de nuevo:"

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:1004
msgid "Checks stay held until you choose."
msgstr "Los cheques se retienen hasta que usted decida."

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:1007
msgid "Forget all choices"
msgstr "Olvida todas las opciones"

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:1008
msgid "Every plugin is asked about again at its next check."
msgstr "Se vuelve a consultar sobre cada complemento en su siguiente comprobación."

# machine translation
#: includes/features/class-seoprostack-link-card-block.php:75
msgid "Link cards"
msgstr "Tarjetas de enlace"

# machine translation
#: includes/features/class-seoprostack-link-card-block.php:76
msgid "Adds a Link card block: paste an address to show the page’s title, description and picture. The picture is copied to your Media Library, so visitors never contact the other site. Bookmark Card blocks keep showing and can be converted."
msgstr "Agrega un bloque de tarjeta de enlace: pega una dirección para mostrar el título, la descripción y la imagen de la página. La imagen se copia a tu biblioteca multimedia, por lo que los visitantes nunca acceden al otro sitio. Los bloques de tarjeta de marcador permanecen visibles y se pueden convertir."

# machine translation
#: includes/features/class-seoprostack-link-card-block.php:294
msgid "The picture’s address is not valid."
msgstr "La dirección de la imagen no es válida."

# machine translation
#: includes/features/class-seoprostack-link-card-block.php:320
msgid "The page’s address is not valid."
msgstr "La dirección de la página no es válida."

# machine translation
#: includes/features/class-seoprostack-link-card-block.php:338
