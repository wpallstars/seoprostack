# machine translation
#: includes/features/class-seoprostack-linking.php:38
msgid "Internal linking tools"
msgstr "Ferramentas de ligação interna"

# machine translation
#: includes/features/class-seoprostack-linking.php:38
msgid "Find local linking opportunities and orphan candidates under Tools → Links. Suggestions use page titles and Rank Math keywords, not a cloud service. Changes require your approval and can be undone."
msgstr "Encontre oportunidades de links locais e links órfãos em Ferramentas → Links. As sugestões usam títulos de páginas e palavras-chave Rank Math, não um serviço em nuvem. As alterações precisam da sua aprovação e podem ser desfeitas."

# machine translation
#: includes/features/class-seoprostack-linking.php:39
msgid "Check linked addresses in the background"
msgstr "Verifique os endereços vinculados em segundo plano."

# machine translation
#: includes/features/class-seoprostack-linking.php:39
msgid "Contact linked websites in small cached batches, never while a visitor waits. Query-bearing, login and API addresses are excluded. A failed request is not proof of a broken link."
msgstr "Contate os sites vinculados em pequenos lotes armazenados em cache, nunca enquanto o visitante espera. Endereços com consultas, logins e endereços API são excluídos. Uma solicitação com falha não comprova que um link está quebrado."

# machine translation
#: includes/features/class-seoprostack-linking.php:40
msgid "Count link clicks"
msgstr "Contar cliques no link"

