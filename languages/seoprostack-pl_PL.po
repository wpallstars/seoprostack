msgstr "Przejdź na górę strony głównej bloga"

# machine translation
#: includes/features/class-seoprostack-sticky-posts.php:89
msgid "Pinned items of these types lead the first page of your latest posts."
msgstr "Przypięte elementy tego typu pojawiają się na pierwszej stronie najnowszych postów."

