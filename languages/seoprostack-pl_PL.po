msgstr "Wyłącz XML-RPC"

# machine translation
#: includes/features/class-seoprostack-hardening.php:124
msgid "Turn off application passwords"
msgstr "Wyłącz hasła aplikacji"

# machine translation
#: includes/features/class-seoprostack-hardening.php:125 includes/features/class-seoprostack-hardening.php:840
