msgid "A test request for a copy did not come back as AVIF or WebP, so browsers may not show it."
msgstr "Żądanie testowe utworzenia kopii nie zostało zwrócone w formacie AVIF lub WebP, dlatego przeglądarki mogą go nie wyświetlać."

# machine translation
#: includes/features/class-seoprostack-nextgen-images.php:1986
