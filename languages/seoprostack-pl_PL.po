msgstr "Strony współdzielą pliki .htaccess strony głównej, więc ustawienia strony głównej blokują pliki dziennika, kopie zapasowe i pliki PHP w przesyłaniu dla całej sieci."

# machine translation
#: includes/features/class-seoprostack-hardening.php:689
msgid "Log and backup files"
msgstr "Pliki dziennika i kopii zapasowej"

# machine translation
#: includes/features/class-seoprostack-hardening.php:694
