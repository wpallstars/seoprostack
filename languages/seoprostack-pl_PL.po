msgstr "Wpis do katalogu"

# machine translation
#: includes/features/class-seoprostack-hardening.php:814
msgid "No log or backup files can be downloaded from this site’s main folders"
msgstr "Nie można pobrać żadnych plików dziennika ani kopii zapasowej z głównych folderów tej witryny"

# machine translation
