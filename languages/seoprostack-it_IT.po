msgstr "Sito %1$d: %2$s"

# machine translation
#: includes/features/class-seoprostack-nextgen-images.php:1658
msgid "CompressX is still active. Deactivate it first."
msgstr "CompressX è ancora attivo. Disattivalo prima."

# machine translation
#: includes/features/class-seoprostack-nextgen-images.php:1662
