# machine translation
#: includes/features/class-seoprostack-plugin-loading.php:1093
msgid "Site pages learn again after changes to content or settings. Last changes that did so:"
msgstr "Le pagine del sito apprendono nuovamente dopo le modifiche al contenuto o alle impostazioni. Ultime modifiche che hanno causato questo processo:"

