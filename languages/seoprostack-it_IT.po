msgid "tomorrow"
msgstr "Domani"

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:709
msgid "in a week"
msgstr "in una settimana"

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:710
msgid "in a month"
msgstr "in un mese"

# machine translation
#: includes/features/class-seoprostack-licence-calls.php:711
msgid "in a year"
msgstr "in un anno"

