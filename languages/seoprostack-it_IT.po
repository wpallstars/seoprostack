msgstr "Le immagini WebP e AVIF non sono supportate o non sono disponibili in questo formato."

# machine translation
#: includes/features/class-seoprostack-nextgen-images.php:1665
msgid "A conversion batch is running. Try again in a few minutes."
msgstr "È in corso un'elaborazione di conversione. Riprova tra qualche minuto."

# machine translation
#. translators: %s: attachment IDs, comma-separated.
#: includes/features/class-seoprostack-nextgen-images.php:1671
#, php-format
msgid "Copies of some pictures could not be made, or their conversion stopped (attachments %s). Make their copies again (Media → Library, Make WebP and AVIF copies), then run the cleanup again."
msgstr "Non è stato possibile creare copie di alcune immagini oppure la loro conversione si è interrotta (allegati %s). Crea nuovamente le copie (Media → Libreria, Crea copie WebP e AVIF), quindi esegui nuovamente la pulizia."

#. translators: %d: number of pictures.
#: includes/features/class-seoprostack-nextgen-images.php:1677
#, php-format
msgid "%d picture is waiting to be converted. Run wp seoprostack convert-images first."
msgid_plural "%d pictures are waiting to be converted. Run wp seoprostack convert-images first."
msgstr[0] "%d immagine è in attesa di essere convertita. Eseguire prima wp seoprostack convert-images."
msgstr[1] "%d immagini sono in attesa di essere convertite. Esegui prima wp seoprostack convert-images."

# machine translation
#: includes/features/class-seoprostack-nextgen-images.php:1793
msgid "The CompressX folder is not a regular folder. No files were removed."
msgstr "La cartella CompressX non è una cartella normale. Nessun file è stato rimosso."

# machine translation
#: includes/features/class-seoprostack-nextgen-images.php:1799
msgid "The CompressX folder contains a link or a special file. No files were removed."
msgstr "La cartella CompressX contiene un collegamento o un file speciale. Nessun file è stato rimosso."

# machine translation
#: includes/features/class-seoprostack-nextgen-images.php:1805
msgid "The CompressX folder could not be read. No files were removed."
msgstr "Impossibile leggere la cartella CompressX. Nessun file è stato rimosso."

