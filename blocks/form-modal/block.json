{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "seoprostack/form-modal",
	"version": "1.3.97",
	"title": "Form modal",
	"category": "widgets",
	"icon": "welcome-widgets-menus",
	"description": "A Fluent form chosen by its key, in a modal that any link to its #ID opens.",
	"keywords": [ "form", "fluent", "modal", "popup", "dialog" ],
	"textdomain": "seoprostack",
	"attributes": {
		"formKey": { "type": "string", "default": "" },
		"modalId": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"intro": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false
	},
	"editorScript": "seoprostack-form-keys-editor"
}
