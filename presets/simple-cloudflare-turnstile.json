{
    "name": "Simple CAPTCHA with Cloudflare Turnstile",
    "tested": "1.44.0",
    "updated": "2026-10-01",
    "notes": "Protects the login, registration, lost password and comment forms and Fluent Forms. The widget follows the visitor's light or dark mode, fills the form's width and only shows when Cloudflare needs the visitor to do something. The site key and secret key are never part of the preset: add them in the plugin's settings, then use its Test button.",
    "options": {
        "cfturnstile_theme": "auto",
        "cfturnstile_appearance": "interaction-only",
        "cfturnstile_size": "flexible",
        "cfturnstile_login": "on",
        "cfturnstile_register": "on",
        "cfturnstile_reset": "on",
        "cfturnstile_comment": "on",
        "cfturnstile_fluent": "on"
    },
    "defaults": {
        "cfturnstile_theme": null,
        "cfturnstile_appearance": null,
        "cfturnstile_size": null,
        "cfturnstile_login": null,
        "cfturnstile_register": null,
        "cfturnstile_reset": null,
        "cfturnstile_comment": null,
        "cfturnstile_fluent": null
    },
    "settings": {
        "cfturnstile_theme": {
            "label": "Theme",
            "description": "Auto follows the visitor’s light or dark setting.",
            "values": {
                "light": "Light",
                "dark": "Dark",
                "auto": "Auto",
                "null": "Light (not set)"
            }
        },
        "cfturnstile_appearance": {
            "label": "Appearance Mode",
            "description": "Interaction Only shows the check only when Cloudflare needs the visitor to click.",
            "values": {
                "always": "Always",
                "interaction-only": "Interaction Only",
                "null": "Always (not set)"
            }
        },
        "cfturnstile_size": {
            "label": "Widget Size",
            "description": "Flexible fits the width of the form.",
            "values": {
                "normal": "Normal (300px)",
                "flexible": "Flexible (100%)",
                "compact": "Compact (150px)",
                "null": "Normal (not set)"
            }
        },
        "cfturnstile_login": {
            "label": "WordPress Login",
            "description": "Turnstile on the login form.",
            "values": {
                "on": "On",
                "": "Off",
                "null": "Off (not set)"
            }
        },
        "cfturnstile_register": {
            "label": "WordPress Register",
            "description": "Turnstile on the registration form.",
            "values": {
                "on": "On",
                "": "Off",
                "null": "Off (not set)"
            }
        },
        "cfturnstile_reset": {
            "label": "WordPress Reset Password",
            "description": "Turnstile on the lost password form.",
            "values": {
                "on": "On",
                "": "Off",
                "null": "Off (not set)"
            }
        },
        "cfturnstile_comment": {
            "label": "WordPress Comment",
            "description": "Turnstile on the comment form.",
            "values": {
                "on": "On",
                "": "Off",
                "null": "Off (not set)"
            }
        },
        "cfturnstile_fluent": {
            "label": "Enable on all Fluent Forms",
            "description": "Turnstile on every Fluent Forms form.",
            "values": {
                "on": "On",
                "": "Off",
                "null": "Off (not set)"
            }
        }
    }
}
